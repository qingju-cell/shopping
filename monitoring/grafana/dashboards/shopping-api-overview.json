{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "接口 QPS（每秒请求数）",
      "targets": [
        {
          "expr": "sum(rate(shopping_http_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "接口 p95 延迟",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shopping_http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "5xx 错误率",
      "targets": [
        {
          "expr": "sum(rate(shopping_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(shopping_http_requests_total[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "累计接口请求数",
      "targets": [
        {
          "expr": "sum(shopping_http_requests_total)",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "title": "AI Token 消耗速率（Token/秒）",
      "targets": [
        {
          "expr": "sum(rate(shopping_ai_tokens_total{token_type=\"total\"}[5m]))",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "title": "AI Token 用量（最近 1 小时，按调用环节）",
      "targets": [
        {
          "expr": "sum by (operation) (increase(shopping_ai_tokens_total{token_type=\"total\"}[1h]))",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "shopping",
    "prometheus"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "购物系统 API 概览",
  "uid": "shopping-api-overview",
  "version": 1
}