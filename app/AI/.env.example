# ============================================================
# AI 模块环境变量配置模板
# 使用方式：复制此文件为 .env，填入真实密钥
#   cp .env.example .env
# ============================================================

# DeepSeek API（用于 AI 对话）
OPENAI_API_KEY=你的DeepSeek_API_Key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 智谱 BigModel API（用于文本嵌入/向量化）
BIGMODEL_API_KEY=你的智谱BigModel_API_Key
